# ============================================================
# Asset Tracker — .gitignore
# ============================================================

# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# ─── Virtual Environments ────────────────────────────────
venv/
.venv/
env/
.env/
ENV/
backend/venv/
backend/.venv/

# ─── Environment Variables (NEVER commit secrets) ────────
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ─── FastAPI / Uvicorn ───────────────────────────────────
*.log
logs/

# ─── Alembic ─────────────────────────────────────────────
# Keep versions folder but ignore compiled cache
backend/app/db/migrations/versions/__pycache__/

# ─── Node / Frontend ─────────────────────────────────────
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp/
.pnp.js

# ─── Vite Build Output ───────────────────────────────────
frontend/dist/
frontend/.vite/
frontend/build/

# ─── User Uploads / Media ────────────────────────────────
storage/users/
!storage/.gitkeep

# ─── Database ────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ─── Docker ──────────────────────────────────────────────
.docker/

# ─── OS Files ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── IDEs & Editors ──────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ─── Testing & Coverage ──────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.hypothesis/

# ─── MyPy / Type Checkers ────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ─── Miscellaneous ───────────────────────────────────────
*.bak
*.tmp
*.temp
